{
  "name": "@folioline/web-react",
  "version": "0.2.0",
  "private": true,
  "description": "Folioline as an installable web app (React)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:npm": "tsc --noEmit && vite build --outDir ../../npm/dist --emptyOutDir --sourcemap false",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@folioline/core": "workspace:*",
    "@folioline/react": "workspace:*",
    "@folioline/web-shared": "workspace:*",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@folioline/relay": "workspace:*",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  }
}
